{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "posts"
    },
    "content": {
      "type": "text",
      "required": false
    },
    "media": {
      "type": "string"
    },
    "gifUrl": {
      "type": "string"
    },
    "tagFriends": {
      "type": "json"
    },
    "sendFriends": {
      "type": "json"
    },
    "mood": {
      "type": "json"
    },
    "sharedLink": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "accessItems": {
      "type": "json"
    },
    "activityRole": {
      "type": "string"
    },
    "storyRole": {
      "type": "string"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "post"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::like.like",
      "mappedBy": "post"
    },
    "shares": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::share.share",
      "mappedBy": "post"
    },
    "sharedFrom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::post.post",
      "inversedBy": "sharedPosts",
      "required": false
    },
    "sharedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "sharedFrom",
      "required": false
    },
    "shareType": {
      "type": "enumeration",
      "enum": [
        "yourFeed",
        "friendsFeed",
        "group",
        "page",
        "friendsMessage"
      ],
      "default": "yourFeed",
      "required": false
    },
    "group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::group.group",
      "inversedBy": "postsGroup",
      "required": false
    }
  }
}
