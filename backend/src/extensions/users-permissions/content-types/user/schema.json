{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "profilePicture": {
      "type": "string"
    },
    "banner": {
      "type": "string"
    },
    "countFriends": {
      "type": "biginteger"
    },
    "phoneNumber": {
      "type": "string"
    },
    "accountType": {
      "type": "string"
    },
    "commentedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "friend"
    },
    "groupMember": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::group-member.group-member",
      "mappedBy": "user"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::like.like",
      "mappedBy": "user"
    },
    "shares": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::share.share",
      "mappedBy": "user"
    },
    "followerRelationships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::relationship.relationship",
      "mappedBy": "follower"
    },
    "followedRelationships": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::relationship.relationship",
      "mappedBy": "followed"
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "author"
    },
    "sharedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::share.share",
      "mappedBy": "friendsFeed"
    },
    "job": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "location": {
      "type": "json"
    }
  }
}
